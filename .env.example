# WebShop+ Environment Configuration
# Copy this file to .env and fill in your values

# LLM Configuration (Nebius - for production/Docker)
# Uses LiteLLM for provider-agnostic calls
LLM_MODEL=nebius/Qwen/Qwen3-32B
LLM_API_KEY=your-nebius-api-key-here

# WebShop Configuration
WEBSHOP_MODE=preview  # preview (1,000 products) or full (1.18M products)
WEBSHOP_DATA_PATH=./webshop/data

# Logging
LOG_LEVEL=INFO
