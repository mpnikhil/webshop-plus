# WebShop+ Local Development Configuration
# Copy this file to .env.local for local development with Ollama

# LLM Configuration (Ollama - for local development)
# Uses LiteLLM for provider-agnostic calls
LLM_MODEL=ollama/qwen3-coder:30b
# Fallback if coder model falters: ollama/qwen3:32b

# WebShop Configuration
WEBSHOP_MODE=preview
WEBSHOP_DATA_PATH=./webshop/data

# Logging
LOG_LEVEL=DEBUG
